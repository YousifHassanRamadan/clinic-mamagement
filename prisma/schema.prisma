generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ====================
// ENUMS
// ====================

enum Role {
  PATIENT
  DOCTOR
}

enum Gender {
  MALE
  FEMALE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum SessionStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TestStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ====================
// USER
// ====================

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email String @unique
  phone String @unique

  address String?
  gender  Gender?

  password String

  role Role @default(PATIENT)

  approval Boolean @default(false)

  emailVerified DateTime?
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  appointments Appointment[]

  availabilities Availability[]

  patientSessions ClinicSession[]


  testsCreated PsychologicalTest[] @relation("TestCreatedBy")

  patientTests PatientTest[]

  @@index([role])
}

// ====================
// AUTH.JS / NEXTAUTH
// ====================

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id String @id @default(cuid())

  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// ====================
// APPOINTMENT
// ====================

model Appointment {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime

  status AppointmentStatus @default(PENDING)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session ClinicSession?

  @@index([userId])
  @@index([date])
  @@index([status])
}

// ====================
// AVAILABLE APPOINTMENT SLOTS
// ====================

model Availability {
  id String @id @default(cuid())

  doctorId String
  doctor   User @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  date DateTime

  startTime DateTime
  endTime   DateTime

  duration Int @default(60)

  isAvailable Boolean @default(true)

  slots AvailabilitySlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, date])
  @@index([doctorId])
  @@index([date])
  @@index([isAvailable])
}

model AvailabilitySlot {
  id String @id @default(cuid())

  availabilityId String
  availability   Availability @relation(fields: [availabilityId],references: [id],onDelete: Cascade)

  time String

  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([availabilityId, time])
  @@index([availabilityId])
  @@index([isAvailable])
}

// ====================
// CLINIC SESSION
// ====================

enum SessionType {
  INITIAL
  FOLLOW_UP
  INDIVIDUAL
  EMERGENCY
  OTHER
}

enum Mood {
  VERY_BAD
  BAD
  NEUTRAL
  GOOD
  VERY_GOOD
}

model ClinicSession {
  id String @id @default(cuid())

  patientId String
  patient   User   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  sessionDate DateTime

  duration Int

  sessionType SessionType @default(INDIVIDUAL)

  mood Mood?

  diagnosis String?

  publicNotes String?

  privateClinicalNotes String?

  shareNotes Boolean @default(true)

  sendSummaryEmail Boolean @default(false)

  status SessionStatus @default(COMPLETED)

  fee Decimal @default(0) @db.Decimal(10, 2)

  attachments SessionAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([sessionDate])
  @@index([status])
}

model SessionAttachment {
  id String @id @default(cuid())

  sessionId String
  session   ClinicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  name String
  url  String
  size Int
  type String

  createdAt DateTime @default(now())

  @@index([sessionId])
}

// ====================
// TEST CATEGORY
// ====================

model TestCategory {
  id String @id @default(cuid())

  name        String
  description String?

  tests PsychologicalTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ====================
// PSYCHOLOGICAL TEST
// ====================

model PsychologicalTest {
  id String @id @default(cuid())

  title       String
  description String?

  isActive Boolean @default(true)

  categoryId String?
  category   TestCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("TestCreatedBy", fields: [createdById], references: [id])

  questions Question[]

  patientTests PatientTest[]

  resultRanges TestResultRange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([createdById])
}

// ====================
// QUESTION
// ====================

model Question {
  id String @id @default(cuid())

  testId String
  test   PsychologicalTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  question String

  order Int

  options QuestionOption[]

  answers Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([testId])
}

// ====================
// QUESTION OPTION
// ====================

model QuestionOption {
  id String @id @default(cuid())

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text String

  // Points given when the patient selects this option
  points Int

  // Option order inside the question
  order Int

  answers Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
}

model TestResultRange {
  id String @id @default(cuid())

  testId String
  test   PsychologicalTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  minScore Int
  maxScore Int

  result String

  order Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([testId])
}

// ====================
// PATIENT TEST
// ====================

model PatientTest {
  id String @id @default(cuid())

  patientId String
  patient   User   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  testId String
  test   PsychologicalTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  status TestStatus @default(NOT_STARTED)

  // Final calculated score
  score Int?

  result String?

  startedAt   DateTime?
  completedAt DateTime?

  answers Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([testId])
}

// ====================
// ANSWER
// ====================

model Answer {
  id String @id @default(cuid())

  patientTestId String
  patientTest   PatientTest @relation(fields: [patientTestId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  optionId String
  option   QuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  // Snapshot of the points at the time of answering
  points Int

  createdAt DateTime @default(now())

  @@index([patientTestId])
  @@index([questionId])
  @@index([optionId])
}
